
import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class RealCalculator extends JFrame implements ActionListener {

    private JTextField display;
    private double firstNumber = 0;
    private String operator = "";
    private boolean newNumber = true;

    public RealCalculator() {
        setTitle("Real Calculator");
        setSize(350, 470);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setResizable(false);

        display = new JTextField("0");
        display.setFont(new Font("Arial", Font.BOLD, 30));
        display.setHorizontalAlignment(JTextField.RIGHT);
        display.setEditable(false);
        display.setBackground(Color.WHITE);

        add(display, BorderLayout.NORTH);

        JPanel panel = new JPanel();
        panel.setLayout(new GridLayout(5, 4, 5, 5));
        panel.setBorder(
            BorderFactory.createEmptyBorder(10, 10, 10, 10)
        );

        String[] buttons = {
            "C", "DEL", "/", "*",
            "7", "8", "9", "-",
            "4", "5", "6", "+",
            "1", "2", "3", "=",
            "0", "."
        };

        for (String text : buttons) {
            JButton button = new JButton(text);
            button.setFont(new Font("Arial", Font.BOLD, 20));
            button.addActionListener(this);

            if ("+-*/".contains(text) && text.length() == 1) {
                button.setBackground(new Color(255, 180, 80));
            } else if (text.equals("=")) {
                button.setBackground(new Color(100, 200, 120));
            } else if (text.equals("C") || text.equals("DEL")) {
                button.setBackground(new Color(240, 100, 100));
            } else {
                button.setBackground(new Color(235, 235, 235));
            }

            panel.add(button);
        }

        add(panel, BorderLayout.CENTER);
        setVisible(true);
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        String command = e.getActionCommand();
        String current = display.getText();

        if (command.equals("C")) {
            display.setText("0");
            firstNumber = 0;
            operator = "";
            newNumber = true;
            return;
        }

        if (command.equals("DEL")) {
            if (newNumber || current.length() <= 1) {
                display.setText("0");
                newNumber = true;
            } else {
                display.setText(
                    current.substring(0, current.length() - 1)
                );
            }
            return;
        }

        if (command.matches("[0-9]")) {
            if (newNumber || current.equals("0")) {
                display.setText(command);
            } else {
                display.setText(current + command);
            }
            newNumber = false;
            return;
        }

        if (command.equals(".")) {
            if (newNumber) {
                display.setText("0.");
                newNumber = false;
            } else if (!current.contains(".")) {
                display.setText(current + ".");
            }
            return;
        }

        if ("+-*/".contains(command) && command.length() == 1) {
            try {
                firstNumber = Double.parseDouble(current);
                operator = command;
                newNumber = true;
            } catch (NumberFormatException ex) {
                display.setText("Error");
            }
            return;
        }

        if (command.equals("=")) {
            if (operator.isEmpty()) {
                return;
            }

            try {
                double secondNumber =
                    Double.parseDouble(current);
                double result;

                switch (operator) {
                    case "+":
                        result = firstNumber + secondNumber;
                        break;

                    case "-":
                        result = firstNumber - secondNumber;
                        break;

                    case "*":
                        result = firstNumber * secondNumber;
                        break;

                    case "/":
                        if (secondNumber == 0) {
                            display.setText("Cannot divide by 0");
                            operator = "";
                            newNumber = true;
                            return;
                        }
                        result = firstNumber / secondNumber;
                        break;

                    default:
                        return;
                }

                if (Double.isFinite(result)) {
                    display.setText(String.valueOf(result));
                } else {
                    display.setText("Error");
                }

                operator = "";
                newNumber = true;

            } catch (NumberFormatException ex) {
                display.setText("Error");
                operator = "";
                newNumber = true;
            }
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new RealCalculator();
        });
    }
}


